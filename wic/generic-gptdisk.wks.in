#
# long-description: Creates a GPT disk image for Rockchip boards

# 0~32K: gpt

part loader1   --offset 64s    --fixed-size 3552K  --part-name loader1   --source rawcopy --sourceparams="file=${SPL_BINARY}"
#part v_storage --offset 7168s  --fixed-size 256K   --part-name v_storage
#part reserved  --offset 7680s  --fixed-size 192K   --part-name reserved1
#part reserved1 --offset 8064s  --fixed-size 32K    --part-name reserved2
#part uboot_env --offset 8128s  --fixed-size 32K    --part-name uboot_env ${RK_UBOOT_ENV}
#part reserved2 --offset 8192s  --fixed-size 4096K  --part-name reserved3
part loader2   --offset 16384s --fixed-size 4096K  --part-name loader2   --source rawcopy --sourceparams="file=u-boot.${UBOOT_SUFFIX}"
#part atf       --offset 24576s --fixed-size 4096K  --part-name atf

part /boot --source bootimg-partition  --fstype=vfat --label boot --ondisk mmcblk0 --active --align 4096 --fixed-size 64M

part --source rawcopy --sourceparams="file=boot.img" --part-name kernelA --align 4096 --fixed-size 64M
part --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${DM_VERITY_IMAGE}-${MACHINE}.${DM_VERITY_IMAGE_TYPE}.verity" --part-name rootfsA --align 8192 --fixed-size ${RK_ROOTFS_AB_PART_SIZE}

part --source rawcopy --sourceparams="file=boot.img" --part-name kernelB --align 4096 --fixed-size 64M
part --source rawcopy --sourceparams="file=${IMGDEPLOYDIR}/${DM_VERITY_IMAGE}-${MACHINE}.${DM_VERITY_IMAGE_TYPE}.verity" --part-name rootfsB --align 8192 --fixed-size ${RK_ROOTFS_AB_PART_SIZE}

part --source rootfs --rootfs-dir=${IMAGE_ROOTFS}/usr/local --fstype=ext4 --part-name data --align 8192 --fixed-size 32M

bootloader --ptable gpt
